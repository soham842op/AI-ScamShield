# Copy this file to .env and fill in values. Never commit real values.

# App
APP_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+psycopg://scamshield:change-me@localhost:5432/scamshield
CLIENT_ID_HASH_KEY=change-me
TRUSTED_PROXY_HOPS=0

# Rate limits
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_ANALYZE_PER_DAY=100
RATE_LIMIT_FEEDBACK_PER_HOUR=30

# URL intelligence
URL_INTEL_PROVIDER=none
URL_INTEL_API_KEY=
URL_INTEL_TIMEOUT_MS=2000
URL_INTEL_DAILY_BUDGET=5000

# LLM (explanations)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=6000
LLM_DAILY_BUDGET=1000
LLM_COOLDOWN_SECONDS=60

# Model
MODEL_ARTIFACT_PATH=ml/artifacts/current/model.joblib
MODEL_ARTIFACT_SHA256=
