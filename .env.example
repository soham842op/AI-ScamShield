# Copy this file to .env and fill in values. Never commit real values.

# App
# Defaults to production when unset. Outside development the backend refuses to
# start without DATABASE_URL and a CLIENT_ID_HASH_KEY of at least 32 characters.
APP_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+psycopg://scamshield:change-me@localhost:5432/scamshield
# Optional: separate role for migrations; falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Secret key for hashing client addresses in the rate limiter. Use a random
# value of 32+ characters (for example: openssl rand -hex 32). "change-me" is
# refused outside development.
CLIENT_ID_HASH_KEY=change-me
TRUSTED_PROXY_HOPS=0

# Rate limits
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_ANALYZE_PER_DAY=100
RATE_LIMIT_FEEDBACK_PER_HOUR=30

# URL intelligence
URL_INTEL_PROVIDER=none
URL_INTEL_API_KEY=
URL_INTEL_TIMEOUT_MS=2000
URL_INTEL_DAILY_BUDGET=5000

# LLM (explanations)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=6000
LLM_DAILY_BUDGET=1000
LLM_COOLDOWN_SECONDS=60

# Model
MODEL_ARTIFACT_PATH=ml/artifacts/current/model.joblib
MODEL_ARTIFACT_SHA256=
